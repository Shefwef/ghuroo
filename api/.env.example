# Copy to api/.env (or repo-root .env) and fill in real values.
# Never commit the filled-in file - it's already gitignored (.env).

# MongoDB Atlas connection string
MONGO_URL=

# JWT signing secret
JWT_SECRET=

# Supabase Storage (tour/blog image uploads)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Runtime
NODE_ENV=development
PORT=8080

# CORS allow-list, comma-separated, no spaces required (trimmed automatically).
# Added by adaptive-maintenance case AM-01 (see maintenance/) so new
# deployment targets (staging subdomain, custom domain, Vercel preview URLs)
# can be added without touching api/index.js. If unset, falls back to the
# single historical origin (https://ghuroo.onrender.com in production,
# http://localhost:5173 in development) - existing deployments need no change.
# Example: ALLOWED_ORIGINS=https://ghuroo.onrender.com,https://ghuroo.app,https://staging.ghuroo.app
ALLOWED_ORIGINS=
